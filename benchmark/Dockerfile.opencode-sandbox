# Docker equivalent of opencode-sandbox.def, for hosts without Apptainer
# (see the CONTAINER_RUNTIME auto-detection in run_case_opencode_deepseek.sh).
# Keep the installed package list in sync with opencode-sandbox.def.
#
# Build with:
#   docker build -t yul-opencode-sandbox -f benchmark/Dockerfile.opencode-sandbox benchmark/
#
# Unlike the Apptainer path, `opencode` is installed HERE at build time,
# not bind-mounted from the host at run time. Apptainer containers share
# the host's kernel/arch (the cluster only ever runs Linux, same as the
# image), so binding the host's own opencode binary in just works. Docker
# has no such guarantee - on a non-Linux host (tested live on macOS) or a
# different-arch Linux host, `docker run` bind-mounting the host binary
# in fails immediately with "exec format error", since it's a
# different-OS/arch executable running under a container built for a
# different one. Baking it in means the image must be rebuilt to pick up
# a newer opencode release (the tradeoff apptainer avoids), but it's the
# only way this actually runs on an arbitrary Docker host.
#
# `yul` is neither baked in nor bind-mounted: in hook runs the opencode-yul
# plugin downloads its own pinned release binary into the run's throwaway
# $HOME, and nohook runs never see it (see run_case_opencode_deepseek.sh).
#
# Toolchains mirror benchmark/Dockerfile (the Claude Code benchmark image),
# so DeepSeek runs see the same environment Claude runs do: every
# benchmarked ecosystem's toolchain, so agents can query registries and
# generate lockfiles as on a dev machine. Containers run as the host uid
# with a throwaway per-run HOME, so per-user caches (~/go, ~/.m2, uv, pip)
# never outlive a run; writes under CARGO_HOME land in the --rm container's
# own layer and are discarded with it.
FROM node:22-trixie

COPY --from=rust:1-trixie /usr/local/rustup /usr/local/rustup
COPY --from=rust:1-trixie /usr/local/cargo /usr/local/cargo
COPY --from=golang:1-trixie /usr/local/go /usr/local/go
COPY --from=maven:3 /opt/java/openjdk /opt/java/openjdk
COPY --from=maven:3 /usr/share/maven /usr/share/maven
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo JAVA_HOME=/opt/java/openjdk \
    PATH=/usr/local/cargo/bin:/usr/local/go/bin:/opt/java/openjdk/bin:/usr/share/maven/bin:$PATH
RUN chmod a+w /usr/local/cargo /usr/local/rustup && rustup component add clippy rustfmt \
    && apt-get update && apt-get install -y --no-install-recommends jq python3-pip python3-venv python-is-python3 gh \
    && rm -rf /var/lib/apt/lists/*

# Pinned so a dataset is reproducible; bump deliberately and record it.
ARG OPENCODE_VERSION=1.18.34
RUN curl -fsSL https://opencode.ai/install | bash -s -- --version "$OPENCODE_VERSION" && \
    mv "$HOME/.opencode/bin/opencode" /usr/local/bin/opencode && \
    chmod 755 /usr/local/bin/opencode
